# graphify: machine-local state, not portable across checkouts
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cost.json
graphify-out/cache
graphify-out/.graphify_labels.json
# graphify's dated backups of the curated graph (e.g. 2026-09-20/) - they
# embed the machine-local labels file and are regenerable from the source
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

