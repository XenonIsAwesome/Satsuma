{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Satsuma",
  "version": "0.1.0",
  "identifier": "io.github.xenonisawesome.satsuma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "satsuma",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "index.html?window=overlay",
        "width": 480,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "lib/ffmpeg": "ffmpeg",
      "lib/pdfium": "pdfium"
    },
    "publisher": "Satsuma",
    "copyright": "Copyright © 2026 XenonIsAwesome",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Offline, cross-platform file converter",
    "longDescription": "Satsuma is an offline, cross-platform file converter for Windows and Linux, inspired by Tangerine (macOS-only). Drag a file onto the app - or select it in your file manager and press Shift - and a citrus-slice-shaped radial menu lets you pick an output format or an advanced tool such as compress, crop, trim, split, or merge. Everything runs locally: no uploads, no network calls for conversion.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/doc/satsuma/copyright": "../LICENSE"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/licenses/satsuma/LICENSE": "../LICENSE"
        }
      }
    },
    "windows": {
      "wix": {
        "upgradeCode": "bad39d6d-6b34-5634-bc22-5f80bd896e6b"
      }
    }
  }
}
